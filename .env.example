# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="your-gemini-api-key-here"

# SEEKAI_API_KEY: API Key for SeekAI (DeepSeek API endpoint https://seekai.cc/v1)
SEEKAI_API_KEY="your-seekai-api-key-here"
SEEKAI_BASE_URL="https://seekai.cc/v1"
SEEKAI_MODEL="deepseek-v4-flash"

# SANITY CMS Configuration
SANITY_PROJECT_ID="your-sanity-project-id"
SANITY_DATASET="production"
SANITY_API_VERSION="2024-01-01"
SANITY_ORGANIZATION_ID="your-sanity-org-id"
SANITY_API_TOKEN="your-sanity-api-token-here"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
